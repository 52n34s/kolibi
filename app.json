{
  "expo": {
    "name": "Kolibi",
    "slug": "kolibi",
    "version": "1.3.0",
    "orientation": "portrait",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/6a372771-7ca2-4394-aba0-18b08be64383",
      "checkAutomatically": "ON_LOAD"
    },
    "icon": "./assets/images/icon.png",
    "scheme": "kolibi",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "com.steffen.kolibi",
      "appleTeamId": "PGR9TXQQM4",
      "supportsTablet": false,
      "config": {
        "usesNonExemptEncryption": false
      },
      "entitlements": {
        "aps-environment": "production",
        "com.apple.developer.healthkit": true,
        "com.apple.developer.healthkit.access": [],
        "com.apple.security.application-groups": [
          "group.com.steffen.kolibi"
        ]
      },
      "infoPlist": {
        "CFBundleDevelopmentRegion": "de",
        "CFBundleLocalizations": [
          "de",
          "en",
          "es"
        ],
        "ITSAppUsesNonExemptEncryption": false,
        "UIBackgroundModes": [
          "remote-notification"
        ],
        "NSHealthShareUsageDescription": "Kolibi reads active energy, heart rate, steps, walking/running distance, waist circumference, body fat percentage, lean body mass and workouts from Apple Health so that your daily and movement goals can take your activity into account.",
        "NSHealthUpdateUsageDescription": "Kolibi writes your logged waist circumference to Apple Health so that it is visible there together with your other health data."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#4F46E5",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.steffen.kolibi",
      "blockedPermissions": [
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.ACCESS_MEDIA_LOCATION"
      ]
    },
    "locales": {
      "de": "./locales/de.json",
      "en": "./locales/en.json",
      "es": "./locales/es.json"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/images/koli-happy.png",
          "imageWidth": 120
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/koli-happy.png",
          "color": "#4F46E5"
        }
      ],
      "expo-apple-authentication",
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.543613260072-7g56l864f40jo3hp420gafahqsp5qgaq"
        }
      ],
      "expo-localization",
      "@react-native-community/datetimepicker",
      "@kingstinct/react-native-healthkit",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Kolibi to access your photos to set a profile picture.",
          "cameraPermission": "Allow Kolibi to access your camera to take photos of your meals, scan barcodes, and set a profile picture.",
          "microphonePermission": false
        }
      ],
      [
        "expo-media-library",
        {
          "savePhotosPermission": "Kolibi saves your stickers to your photo library.",
          "isAccessMediaLocationEnabled": false,
          "granularPermissions": []
        }
      ],
      "./plugins/with-add-only-media-permissions.js",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Kolibi to access your camera to take photos of your meals, scan barcodes, and set a profile picture.",
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": true
        }
      ],
      "./plugins/with-ios-modular-headers.js",
      "@bacons/apple-targets",
      "expo-asset",
      [
        "expo-secure-store",
        {
          "faceIDPermission": false
        }
      ],
      [
        "@sentry/react-native/expo",
        {
          "url": "https://sentry.io/",
          "project": "kolibi",
          "organization": "52n34s-group"
        }
      ],
      "@sentry/react-native",
      "expo-image",
      "expo-status-bar",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "6a372771-7ca2-4394-aba0-18b08be64383"
      }
    }
  }
}
